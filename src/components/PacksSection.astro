---
// Packs Section Component
const baseUrl = import.meta.env.BASE_URL;
const packs = [
  { id: 1, image: `${baseUrl}/images/3%20-%20pack%201.png`, alt: 'Afterglow Pack' },
  { id: 2, image: `${baseUrl}/images/3%20-%20pack%202.png`, alt: 'Haute Haus Pack' },
  { id: 3, image: `${baseUrl}/images/3%20-%20pack%203.png`, alt: 'Euphoria // UV Pack' },
  { id: 4, image: `${baseUrl}/images/3%20-%20pack%204.png`, alt: 'Ground Control Pack' },
];
---

<section class="packs-section">
  <div class="container">
    <h2 class="section-title text-center">
      <span class="blue-bold-text">EXPAND YOUR WARDROBE WITH</span><br />
      <span class="pink-gradient-text">Limited-Edition Packs</span>
    </h2>
    <div class="packs-grid">
      {packs.map((pack) => (
        <div class="pack-card">
          <img 
            src={pack.image} 
            alt={pack.alt}
            loading="lazy"
            width="600"
            height="400"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .packs-section {
    background: var(--white);
    padding: var(--spacing-xxl) 0;
  }

  .section-title {
    margin-bottom: var(--spacing-xl);
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.2;
  }

  .packs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
    max-width: 900px;
    margin: 0 auto;
  }

  .pack-card {
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .pack-card:hover {
    transform: translateY(-6px);
  }

  .pack-card img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: clamp(1.5rem, 6vw, 2.2rem);
    }
    
    .packs-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-sm);
    }
    
    .pack-card {
      border-radius: var(--border-radius);
    }
  }
</style>
