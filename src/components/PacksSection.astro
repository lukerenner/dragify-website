---
// Packs Section Component
const packs = [
  { id: 1, image: '/images/3 - pack 1.png', alt: 'Limited Edition Pack 1' },
  { id: 2, image: '/images/3 - pack 2.png', alt: 'Limited Edition Pack 2' },
  { id: 3, image: '/images/3 - pack 3.png', alt: 'Limited Edition Pack 3' },
  { id: 4, image: '/images/3 - pack 4.png', alt: 'Limited Edition Pack 4' },
];
---

<section class="packs-section">
  <div class="container">
    <h2 class="section-title gradient-text">
      Expand your wardrobe with<br />
      <em>Limited-Edition</em> Packs
    </h2>
    <div class="packs-grid">
      {packs.map((pack) => (
        <div class="pack-card">
          <img 
            src={pack.image} 
            alt={pack.alt}
            loading="lazy"
            width="500"
            height="600"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .packs-section {
    background: var(--white);
  }

  .section-title {
    text-align: center;
    margin-bottom: var(--spacing-lg);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.2;
  }

  .section-title em {
    font-style: italic;
    display: block;
  }

  .packs-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-md);
  }

  .pack-card {
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .pack-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
  }

  .pack-card img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: clamp(1.5rem, 6vw, 2.5rem);
    }
    
    .packs-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-sm);
    }
    
    .pack-card {
      border-radius: var(--border-radius);
    }
  }
</style>
