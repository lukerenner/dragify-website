---
// Footer Component
import { config } from '../config';
---

<footer class="site-footer">
  <div class="footer-gradient">
    <div class="container footer-container">
      <h2 class="footer-heading text-center">Contact Support or send us a message</h2>
      
      <form 
        action={config.formEndpoint}
        method="POST"
        class="contact-form"
      >
        <div class="form-columns">
          <div class="form-col-left">
            <div class="form-group">
              <input type="text" id="name" name="name" placeholder="Name" required />
            </div>
            <div class="form-group">
              <input type="email" id="email" name="email" placeholder="Email" required />
            </div>
          </div>
          <div class="form-col-right">
            <div class="form-group">
              <textarea id="message" name="message" rows="4" placeholder="Message" required></textarea>
            </div>
          </div>
        </div>
        <button type="submit" class="hidden-submit" style="display: none;">Submit</button>
      </form>

      <div class="footer-bottom">
        <div class="footer-tagline">
          Made with love by drag queens for drag queens (especially queens like you!) 💅
        </div>
        <div class="footer-links">
          <a href="/terms">Terms of Service</a>
          <a href="/privacy">Privacy Policy</a>
          <a href="/open-source">Open Source Licenses</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
  }

  .footer-gradient {
    background: linear-gradient(90deg, #064AAD 0%, #AF49E8 100%);
    padding: var(--spacing-xl) 0;
    color: var(--white);
  }

  .footer-container {
    max-width: 1000px;
  }

  .footer-heading {
    color: var(--white);
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: var(--spacing-lg);
    font-family: var(--font-text); /* Matches the UI font in image, looks like Inter/System */
  }

  .contact-form {
    margin-bottom: var(--spacing-lg);
  }

  .form-columns {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-md);
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 1rem;
    border: none;
    border-radius: 8px;
    background: var(--white);
    color: #8E3BB8; /* Purple text placeholder color from image roughly */
    font-family: var(--font-text);
    font-size: 1rem;
    font-weight: 600;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: #A962D6; /* Lighter purple placeholder */
    font-weight: 700;
  }
  
  .form-group textarea {
    height: 100%;
    resize: none;
    min-height: 120px;
  }

  .form-col-left {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: var(--spacing-xl);
    font-size: 0.9rem;
  }

  .footer-tagline {
    font-weight: 600;
    max-width: 50%;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-align: right;
  }

  .footer-links a {
    color: var(--white);
    text-decoration: none;
    font-weight: 600;
    opacity: 0.9;
    transition: opacity 0.2s;
  }

  .footer-links a:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .form-columns {
      grid-template-columns: 1fr;
    }
    
    .footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: var(--spacing-lg);
    }
    
    .footer-tagline {
      max-width: 100%;
    }
    
    .footer-links {
      text-align: center;
    }
  }
</style>
