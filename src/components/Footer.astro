---
// Footer Component
import { config } from '../config';
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
  <div class="footer-gradient">
    <div class="container footer-container">
      <h2 class="footer-heading text-center">Contact support or send us a message</h2>
      
      <form 
        action={config.formEndpoint}
        method="POST"
        class="contact-form"
      >
        <div class="form-row inputs-row">
          <div class="form-group">
            <label for="name" class="sr-only">Name</label>
            <input type="text" id="name" name="name" placeholder="Name" autocomplete="name" required />
          </div>
          <div class="form-group">
            <label for="email" class="sr-only">Email</label>
            <input type="email" id="email" name="email" placeholder="Email" autocomplete="email" required />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="message" class="sr-only">Message</label>
            <textarea id="message" name="message" rows="3" placeholder="Message" required></textarea>
          </div>
        </div>
        <div class="form-row submit-row">
          <button type="submit" class="submit-btn">SUBMIT</button>
        </div>
      </form>

      <div class="footer-bottom">
        <div class="footer-links">
          <a href={`${baseUrl}/drag-name-generator`}>Drag Name Generator</a>
          <a href={`${baseUrl}/terms`}>Terms of Service</a>
          <a href={`${baseUrl}/privacy`}>Privacy Policy</a>
          <a href={`${baseUrl}/open-source`}>Open Source Licenses</a>
        </div>
        <div class="footer-tagline">
          <div>Made with love by drag queens</div>
          <div>for drag queens (especially</div>
          <div>queens like you!) 💅</div>
          <br />
          <div class="copyright">©️ Elevator Beat LLC, 2026</div>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;
  }

  .footer-gradient {
    background: linear-gradient(90deg, #064AAD 0%, #AF49E8 100%);
    padding: var(--spacing-xxl) 0;
    color: var(--white);
  }

  .footer-container {
    max-width: 900px;
    padding: 0 var(--spacing-lg); /* Add horizontal padding to prevent edge touching */
  }

  .footer-heading {
    color: var(--white);
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: var(--spacing-lg);
    font-family: var(--font-text);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 4rem; /* Spacing between form and bottom text */
    max-width: 800px;
    margin-left: auto;
    margin-right: auto;
  }

  .form-row {
    width: 100%;
  }

  .inputs-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .form-group input,
  .form-group textarea {
    width: 100%;
    padding: 1rem; /* Generous padding like image */
    border: none;
    border-radius: 8px;
    background: var(--white);
    color: #8E3BB8; 
    font-family: var(--font-text);
    font-size: 1rem;
    font-weight: 600;
  }

  /* Placeholder styling matching the purple/pink vibe */
  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: #8E3BB8; /* ~6:1 on white — meets WCAG AA */
    font-weight: 700;
    opacity: 1; /* Firefox lowers placeholder opacity by default */
  }
  
  .form-group textarea {
    height: 120px;
    resize: none;
  }

  .submit-row {
    display: flex;
    justify-content: center;
    margin-top: 0.5rem;
  }

  .submit-btn {
    background: var(--white);
    color: #064AAD; /* Fallback */
    background-clip: text;
    -webkit-background-clip: text;
    /* Create a gradient text for SUBMIT: Blue to Pink */
    background-image: linear-gradient(90deg, #064AAD 0%, #AF49E8 100%);
    
    font-family: var(--font-text);
    font-weight: 800;
    text-transform: uppercase;
    font-size: 1.2rem; /* ≥18.66px bold = WCAG large text (3:1 threshold) */
    letter-spacing: 1px;
    
    /* The button box itself needs white background */
    background-color: var(--white);
    /* Since we used background-clip for text, the background-color won't show if we don't handle it carefully.
       Actually, standard "text gradient" on a button is tricky.
       Easier: Make button white, put a span inside with gradient text.
       But here I'll just use solid blue text if gradient is too complex for single element.
       Let's try standard styling: White button, Blue-ish Purple Text.
    */
    background: var(--white); /* Reset background to solid white */
    -webkit-background-clip: border-box; /* Reset clip */
    background-clip: border-box;
    color: #5d46be; /* Mix of blue/purple */
    
    border: none;
    padding: 1rem 4rem; /* Wide button */
    border-radius: 8px;
    cursor: pointer;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    transition: transform 0.2s;
  }
  
  /* Let's try to make the text gradient inside the white button */
  .submit-btn {
    color: transparent;
    background: var(--white);
    position: relative;
    z-index: 1;
  }
  
  .submit-btn::before {
    content: 'SUBMIT';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    background: linear-gradient(90deg, #064AAD 0%, #AF49E8 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .submit-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(0,0,0,0.15);
  }

  .copyright {
    color: var(--white);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.4;
    width: 100%;
    max-width: 1000px;
    margin: 0 auto;
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    text-align: left; /* Changed from right since links are now on left */
    gap: 0;
  }

  .footer-tagline {
    text-align: right; /* Changed from left since tagline is now on right */
  }

  .footer-links a {
    color: var(--white);
    text-decoration: none;
    opacity: 0.95;
    transition: opacity 0.2s;
  }

  .footer-links a:hover {
    opacity: 1;
  }

  @media (max-width: 768px) {
    .inputs-row {
      grid-template-columns: 1fr;
    }
    
    .footer-bottom {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 2rem;
    }
    
    .footer-tagline {
      text-align: center;
    }
    
    .footer-links {
      text-align: center;
    }
  }
</style>
