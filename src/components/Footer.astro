---
import { config } from '../config';
---

<footer class="site-footer" id="contact">
  <div class="footer-gradient">
    <div class="container">
      <div class="footer-content">
        <h3 class="footer-heading">Contact Support or send us a message</h3>
        
        <form 
          action={config.formEndpoint}
          method="POST"
          class="contact-form"
        >
          <div class="form-group">
            <label for="name">Name</label>
            <input 
              type="text" 
              id="name" 
              name="name" 
              required 
              placeholder="Your name"
            />
          </div>
          
          <div class="form-group">
            <label for="email">Email</label>
            <input 
              type="email" 
              id="email" 
              name="email" 
              required 
              placeholder="your@email.com"
            />
          </div>
          
          <div class="form-group">
            <label for="message">Message</label>
            <textarea 
              id="message" 
              name="message" 
              rows="5" 
              required
              placeholder="How can we help you?"
            ></textarea>
          </div>
          
          <button type="submit" class="btn btn-white">Send Message</button>
        </form>
      </div>
    </div>
  </div>
  
  <div class="footer-bottom">
    <div class="container">
      <div class="footer-links">
        <a href="/terms">Terms of Service</a>
        <a href="/privacy">Privacy Policy</a>
        <a href="/open-source">Open Source</a>
      </div>
      <p class="footer-tagline">
        Made with love by drag queens for drag queens (especially queens like you!) 💖✨
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--spacing-xl);
  }

  .footer-gradient {
    background: var(--gradient);
    padding: var(--spacing-xl) 0;
    color: var(--white);
  }

  .footer-content {
    max-width: 600px;
    margin: 0 auto;
  }

  .footer-heading {
    text-align: center;
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: var(--spacing-lg);
    color: var(--white);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-md);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .form-group input,
  .form-group textarea {
    padding: 1rem;
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.1);
    color: var(--white);
    font-family: inherit;
    font-size: 1rem;
    transition: all 0.3s ease;
  }

  .form-group input::placeholder,
  .form-group textarea::placeholder {
    color: rgba(255, 255, 255, 0.6);
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--white);
    background: rgba(255, 255, 255, 0.2);
  }

  .contact-form .btn {
    margin-top: var(--spacing-sm);
    align-self: center;
  }

  .footer-bottom {
    background: #f8f8f8;
    padding: var(--spacing-md) 0;
    text-align: center;
  }

  .footer-links {
    display: flex;
    justify-content: center;
    gap: var(--spacing-md);
    margin-bottom: var(--spacing-sm);
    flex-wrap: wrap;
  }

  .footer-links a {
    color: var(--gradient-start);
    text-decoration: none;
    font-weight: 600;
    transition: color 0.3s ease;
  }

  .footer-links a:hover {
    color: var(--gradient-end);
  }

  .footer-tagline {
    font-size: 0.9rem;
    color: var(--text-dark);
    font-style: italic;
  }

  @media (max-width: 768px) {
    .footer-heading {
      font-size: 1.3rem;
    }
    
    .footer-links {
      flex-direction: column;
      gap: var(--spacing-sm);
    }
    
    .footer-tagline {
      font-size: 0.85rem;
      padding: 0 var(--spacing-sm);
    }
  }
</style>
