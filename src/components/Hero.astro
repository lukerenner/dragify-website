---
import { config } from '../config';
const baseUrl = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        <h1 class="hero-title">
          <span class="blue-bold-text">Dragify</span>
        </h1>
        <p class="hero-subtitle">
          <span class="pink-gradient-text">DISCOVER YOUR</span><br />
          <span class="pink-gradient-text">INNER QUEEN.</span> 👑✨
        </p>
        <a href={config.appStoreUrl} class="app-store-link">
          <img src={`${baseUrl}images/Download.png`} alt="Download on the App Store" width="135" height="40" />
        </a>
      </div>
      <div class="hero-image">
        <img src={`${baseUrl}images/1%20-%20header.png`} alt="Dragify App on iPhone" width="350" height="700" />
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--white);
    padding: var(--spacing-lg) 0;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-xl);
    align-items: center;
  }

  .hero-content {
    padding-right: var(--spacing-md);
  }

  .hero-title {
    font-size: clamp(3.5rem, 8vw, 5.5rem);
    margin-bottom: var(--spacing-sm);
    line-height: 0.9;
  }

  .hero-subtitle {
    font-size: clamp(1.3rem, 2.5vw, 1.6rem);
    font-weight: 800;
    margin-bottom: var(--spacing-lg);
    line-height: 1.2;
  }

  .app-store-link {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .app-store-link:hover {
    transform: scale(1.05);
  }

  .app-store-link img {
    height: 40px;
    width: auto;
  }

  .hero-image {
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .hero-image img {
    max-width: 100%;
    height: auto;
    filter: drop-shadow(0 20px 40px rgba(0, 0, 0, 0.15));
  }

  @media (max-width: 968px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: var(--spacing-md);
    }

    .hero-content {
      text-align: center;
      padding-right: 0;
      order: 2;
    }

    .hero-image {
      order: 1;
    }

    .hero-image img {
      max-width: 280px;
    }
  }
</style>
