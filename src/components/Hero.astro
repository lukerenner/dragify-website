---
import { config } from '../config';
const baseUrl = import.meta.env.BASE_URL;
---

<section class="hero" style={`background-image: url('${baseUrl}/images/Full%20Header.png')`}>
  <div class="container">
    <div class="hero-grid">
      <div class="hero-content">
        <h1 class="hero-title">
          <span class="gradient-text">Dragify</span>
        </h1>
        <p class="hero-subtitle">
          <span class="pink-gradient-text">DISCOVER YOUR</span><br />
          <span class="pink-gradient-text">INNER QUEEN.</span> 💅
        </p>
        <a href={config.appStoreUrl} class="app-store-link">
          <img src={`${baseUrl}/images/Download.png`} alt="Download on the App Store" width="270" height="80" />
        </a>
      </div>
      <!-- Hero Image removed, replaced by section background -->
    </div>
  </div>
</section>

<style>
  .hero {
    /* Background image set inline for dynamic base path */
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    padding: 0;
    overflow: hidden;
    position: relative;
    width: 100%;
    min-height: 100vh; /* Full viewport height */
    display: flex;
    align-items: center;
  }

  .hero-grid {
    display: block;
    max-width: 1400px;
    margin: 0 auto;
    width: 100%;
    height: 100%;
  }

  .hero-content {
    padding-left: var(--spacing-lg);
    z-index: 10;
    padding-top: var(--spacing-xl);
    padding-bottom: var(--spacing-xl);
    max-width: 600px;
  }

  .hero-title {
    font-size: clamp(3.5rem, 8vw, 6rem);
    line-height: 1;
    margin-bottom: var(--spacing-xs);
  }

  .hero-subtitle {
    font-size: clamp(1.2rem, 2.5vw, 2rem);
    line-height: 1.2;
    margin-bottom: var(--spacing-md);
    font-weight: 700;
  }

  .app-store-link {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .app-store-link:hover {
    transform: translateY(-2px);
  }

  .app-store-link img {
    height: 80px;
    width: auto;
  }
  
  @media (max-width: 768px) {
    .hero {
      background: #FFFFFF !important; /* Remove background on mobile */
      min-height: auto;
      padding: var(--spacing-lg) 0;
    }
    
    .hero-content {
      padding-left: var(--spacing-md);
      padding-right: var(--spacing-md);
      text-align: left;
      max-width: 100%;
      padding-top: var(--spacing-md);
      padding-bottom: var(--spacing-md);
    }
    
    .hero-title {
      font-size: clamp(2.5rem, 10vw, 4rem);
    }
    
    .app-store-link img {
      height: 60px;
      width: auto;
    }
    
    /* Show background image as regular image on mobile */
    .hero-grid::after {
      content: '';
      display: block;
      width: 100%;
      height: 0;
      padding-bottom: 100%; /* Square aspect ratio, adjust as needed */
      background-image: inherit; /* Will inherit from parent's inline style */
      background-size: cover;
      background-position: center;
      margin-top: var(--spacing-lg);
    }
  }
</style>
