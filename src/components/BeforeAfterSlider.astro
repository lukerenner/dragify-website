---
// Before/After Slider Component
const baseUrl = import.meta.env.BASE_URL;
---

<section class="slider-section">
  <div class="container">
    <h2 class="section-title text-center">
      <span class="gradient-text h1-style">Release the queen inside you.</span>
    </h2>
    <div class="slider-container">
      <div class="slider-images">
        <!-- Bottom image is After (Queen, visible on Right) -->
        <img 
          src={`${baseUrl}/images/4%20-%20after.webp`}
          alt="After transformation" 
          class="slider-image slider-image-bottom"
          width="800"
          height="1067"
          loading="lazy"
        />
        <!-- Top image is Before (Guy, clipped to show on Left) -->
        <img 
          src={`${baseUrl}/images/4%20-%20before.webp`}
          alt="Before transformation" 
          class="slider-image slider-image-top"
          id="topImage"
          width="800"
          height="1067"
          loading="lazy"
        />
      </div>
      <input 
        type="range" 
        min="0" 
        max="100" 
        value="50" 
        class="slider-control"
        id="sliderControl"
        aria-label="Before and after comparison slider"
      />
      <div class="slider-handle" id="sliderHandle"></div>
    </div>
  </div>
</section>

<script>
  const slider = document.getElementById('sliderControl') as HTMLInputElement;
  const topImage = document.getElementById('topImage') as HTMLElement;
  const handle = document.getElementById('sliderHandle') as HTMLElement;

  function updateSlider(value: number) {
    const percentage = value;
    // inset(0 right bottom left)
    // We want to clip the Top Image (Before) from the Right side.
    topImage.style.clipPath = `inset(0 ${100 - percentage}% 0 0)`;
    handle.style.left = `${percentage}%`;
  }

  if (slider && topImage && handle) {
    slider.addEventListener('input', (e) => {
      const target = e.target as HTMLInputElement;
      updateSlider(Number(target.value));
    });

    // Initialize at 50%
    updateSlider(50);
  }
</script>

<style>
  .slider-section {
    background: #FFFFFF;
    padding: var(--spacing-xxl) 0;
  }

  .section-title {
    margin-bottom: var(--spacing-xl);
    line-height: 1.1;
  }

  .h1-style {
    font-size: clamp(3rem, 6vw, 5rem);
  }
  
  .slider-container {
    position: relative;
    width: 100%;
    max-width: 900px; /* Increased max-width for landscape */
    margin: 0 auto;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0,0,0,0.2);
  }

  .slider-images {
    position: relative;
    width: 100%;
    aspect-ratio: 6 / 4; /* Landscape 6:4 */
    overflow: hidden;
  }

  .slider-image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%; /* Adjusted to focus on faces since we are cropping portrait to landscape */
  }

  .slider-image-bottom {
    z-index: 1;
  }

  .slider-image-top {
    z-index: 2;
  }

  .slider-control {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 3;
    opacity: 0;
    cursor: ew-resize;
  }

  .slider-handle {
    position: absolute;
    top: 0;
    left: 50%;
    width: 4px;
    height: 100%;
    background: var(--white);
    z-index: 4;
    pointer-events: none;
    transform: translateX(-50%);
    box-shadow: 0 0 10px rgba(0,0,0,0.3);
    display: flex;
    justify-content: center;
    align-items: center;
  }

  .slider-handle::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 50px;
    height: 50px;
    background: var(--white);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 20px rgba(0,0,0,0.3);
    border: 3px solid var(--gradient-start);
  }

  .slider-handle::after {
    content: '⟷';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 24px;
    color: var(--gradient-start);
    font-weight: bold;
    line-height: 1; /* Fix vertical centering */
    margin-top: -2px; /* Slight visual adjustment */
  }

  @media (max-width: 768px) {

    
    .slider-container {
      border-radius: var(--border-radius);
    }
    
    .slider-handle::before {
      width: 60px;
      height: 60px;
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .slider-control {
      cursor: grab;
    }
    .slider-control:active {
      cursor: grabbing;
    }
  }
</style>
