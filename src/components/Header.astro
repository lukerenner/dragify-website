---
import { config } from '../config';
---

<header class="site-header">
  <div class="container header-content">
    <div class="logo">
      <span class="gradient-text-header">Dragify</span>
    </div>
    <a href={config.appStoreUrl} class="btn btn-primary header-cta">Get the App</a>
  </div>
</header>

<style>
  .site-header {
    background: var(--gradient);
    padding: 1.25rem 0;
    position: sticky;
    top: 0;
    z-index: 100;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .header-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-family: var(--font-heading);
    font-size: 1.75rem;
  }

  .gradient-text-header {
    color: var(--white);
  }

  .header-cta {
    background: var(--white);
    color: var(--blue);
    font-weight: 700;
    padding: 0.75rem 1.75rem;
    font-size: 0.9rem;
  }

  .header-cta:hover {
    background: rgba(255, 255, 255, 0.95);
    transform: translateY(-1px);
  }

  @media (max-width: 768px) {
    .logo {
      font-size: 1.4rem;
    }
    
    .header-cta {
      padding: 0.65rem 1.4rem;
      font-size: 0.85rem;
    }
  }
</style>
