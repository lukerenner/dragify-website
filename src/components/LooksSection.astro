---
// Looks Section Component
const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="looks-section">
  <div class="header-container text-center">
    <h2 class="section-title">
      <span class="pink-text h3-style">EXPLORE DOZENS OF</span><br />
      <span class="gradient-text h1-style">Unforgettable looks</span>
    </h2>
  </div>
  <div class="looks-image-container">
    <picture>
      <source media="(max-width: 768px)" srcset={`${baseUrl}/images/mobile%202%20-%20looks.webp`} />
      <img 
        src={`${baseUrl}/images/2%20-%20looks.webp`}
        alt="Collection of drag queen looks" 
        loading="lazy"
        width="2400"
        height="1200"
      />
    </picture>
  </div>
</section>

<style>
  .looks-section {
    background: #FFFFFF;
    padding: var(--spacing-xxl) 0;
    overflow: hidden;
  }

  .header-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .section-title {
    margin-bottom: var(--spacing-xl);
    line-height: 1.1;
  }

  .h1-style {
    font-size: clamp(3rem, 6vw, 5rem);
  }

  .h3-style {
    font-size: clamp(1.2rem, 3vw, 1.8rem);
  }

  .looks-image-container {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .looks-image-container img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: clamp(1.5rem, 6vw, 2.2rem);
    }
    
    .looks-image {
      border-radius: var(--border-radius);
    }
  }
</style>
