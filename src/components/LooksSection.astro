---
// Looks Section Component
const baseUrl = import.meta.env.BASE_URL;
---

<section class="looks-section">
  <div class="header-container text-center">
    <h2 class="section-title">
      <span class="pink-gradient-text">EXPLORE DOZENS OF</span><br />
      <span class="gradient-text">Unforgettable looks</span>
    </h2>
  </div>
  <div class="looks-image-container">
    <img 
      src={`${baseUrl}/images/2%20-%20looks.png`}
      alt="Collection of drag queen looks" 
      loading="lazy"
      width="2400"
      height="1200"
    />
  </div>
</section>

<style>
  .looks-section {
    background: var(--white);
    padding: var(--spacing-xxl) 0;
    overflow: hidden;
  }

  .header-container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 var(--spacing-md);
  }

  .section-title {
    margin-bottom: var(--spacing-xl);
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.2;
  }

  .looks-image-container {
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .looks-image-container img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: clamp(1.5rem, 6vw, 2.2rem);
    }
    
    .looks-image {
      border-radius: var(--border-radius);
    }
  }
</style>
