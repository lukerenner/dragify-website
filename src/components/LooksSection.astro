---
// Looks Section Component
const baseUrl = import.meta.env.BASE_URL;
---

<section class="looks-section">
  <div class="container">
    <h2 class="section-title text-center">
      <span class="pink-gradient-text">EXPLORE DOZENS OF</span><br />
      <span class="blue-bold-text">Unforgettable looks</span>
    </h2>
    <div class="looks-image">
      <img 
        src={`${baseUrl}images/2%20-%20looks.png`}
        alt="Collection of drag queen looks" 
        loading="lazy"
        width="1200"
        height="600"
      />
    </div>
  </div>
</section>

<style>
  .looks-section {
    background: var(--white);
    padding: var(--spacing-xxl) 0;
  }

  .section-title {
    margin-bottom: var(--spacing-xl);
    font-size: clamp(1.8rem, 4vw, 3rem);
    line-height: 1.2;
  }

  .looks-image {
    width: 100%;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
  }

  .looks-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: clamp(1.5rem, 6vw, 2.2rem);
    }
    
    .looks-image {
      border-radius: var(--border-radius);
    }
  }
</style>
