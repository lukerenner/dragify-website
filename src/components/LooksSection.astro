---
// Looks Section Component
---

<section class="looks-section">
  <div class="container">
    <h2 class="section-title gradient-text">
      Explore dozens of<br />
      <em>Unforgettable</em> looks
    </h2>
    <div class="looks-grid">
      <img 
        src="/images/2 - looks.png" 
        alt="Collection of drag queen looks" 
        loading="lazy"
        width="1200"
        height="400"
      />
    </div>
  </div>
</section>

<style>
  .looks-section {
    background: var(--white);
  }

  .section-title {
    text-align: center;
    margin-bottom: var(--spacing-lg);
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1.2;
  }

  .section-title em {
    font-style: italic;
    display: block;
  }

  .looks-grid {
    width: 100%;
    border-radius: var(--border-radius-lg);
    overflow: hidden;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
  }

  .looks-grid img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: clamp(1.5rem, 6vw, 2.5rem);
    }
    
    .looks-grid {
      border-radius: var(--border-radius);
    }
  }
</style>
