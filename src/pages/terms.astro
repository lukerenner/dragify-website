---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Terms of Service - Dragify">
  <Header />
  <main class="legal-page">
    <div class="container">
      <div class="legal-content">
        <h1>Terms of Service</h1>
        <p class="last-updated">Last Updated: [DATE]</p>
        
        <div class="placeholder-content">
          <p><em>Legal content will be added here.</em></p>
          <p>This is a placeholder for the Terms of Service. The actual legal text will be provided and inserted here.</p>
        </div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<style>
  .legal-page {
    min-height: 60vh;
    padding: var(--spacing-xl) 0;
  }

  .legal-content {
    max-width: 800px;
    margin: 0 auto;
  }

  .legal-content h1 {
    font-size: clamp(2rem, 4vw, 3rem);
    margin-bottom: var(--spacing-sm);
    background: var(--gradient);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .last-updated {
    color: #666;
    font-size: 0.9rem;
    margin-bottom: var(--spacing-lg);
  }

  .placeholder-content {
    padding: var(--spacing-lg);
    background: #f8f8f8;
    border-radius: var(--border-radius);
    border-left: 4px solid var(--gradient-start);
  }

  .placeholder-content p {
    margin-bottom: var(--spacing-sm);
  }

  .placeholder-content em {
    color: var(--gradient-end);
    font-weight: 600;
  }
</style>
